# ============================================================
# Azure Billing MCP Server — Local Development Environment
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On Cloud Run, AZURE_TENANT_ID and AZURE_CLIENT_ID are passed
# as --set-env-vars; AZURE_CLIENT_SECRET is injected from GCP
# Secret Manager. This .env file is for LOCAL DEV ONLY.
# ============================================================

# ------------------------------------------------------------------
# Azure Cost Management service principal
# ------------------------------------------------------------------
# This is the app registration created in Step 1 of SETUP.md.
# It is SEPARATE from the Gemini Enterprise OAuth app (Step 3).
# Required roles: Cost Management Reader, Billing Reader.
# ------------------------------------------------------------------

# Directory (tenant) ID — found on the app registration Overview page
AZURE_TENANT_ID=<your-azure-tenant-id>

# Application (client) ID — found on the app registration Overview page
AZURE_CLIENT_ID=<your-azure-client-id>

# Client secret value — created in Step 1.3 of SETUP.md.
# Copy the Value immediately after creating it (it is hidden afterwards).
# In production this is stored in GCP Secret Manager, not here.
AZURE_CLIENT_SECRET=<your-azure-client-secret>

# ------------------------------------------------------------------
# Second Azure tenant (optional — for multi-tenant / client handover)
# ------------------------------------------------------------------
# When set, requests from users in this tenant are automatically routed
# to these credentials instead of the primary ones above.
# The service principal in this tenant also needs Cost Management Reader
# and Billing Reader roles (same as SETUP.md Steps 1-2).
# In production, store AZURE_CLIENT_SECRET_2 in GCP Secret Manager as
# "Azure_secret_value_2" and reference it in deploy_cloudrun.sh.
# ------------------------------------------------------------------

# AZURE_TENANT_ID_2=<second-azure-tenant-id>
# AZURE_CLIENT_ID_2=<second-azure-client-id>
# AZURE_CLIENT_SECRET_2=<second-azure-client-secret>

# ------------------------------------------------------------------
# Optional overrides
# ------------------------------------------------------------------

# HTTP port the server listens on (default: 8080)
# PORT=8080

# Logging verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
